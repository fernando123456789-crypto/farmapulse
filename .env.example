# Genera una SECRET_KEY privada y estable para este servidor.
SECRET_KEY=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
# Registro, reenvío y recuperación comparten 5 solicitudes/hora; login: 5/15 minutos.
# Producción requiere HTTPS, clave privada estable de al menos 32 caracteres y Redis.
APP_ENV=development
RATELIMIT_STORAGE_URI=memory://
RENIEC_TOKEN=

# Solo credenciales de un comercio de pruebas de Perú. Los comercios reales se bloquean.
# Mantén el Access Token privado. Los compradores no necesitan cuenta de Mercado Pago.
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
# Solo con un comercio de pruebas verificado por /users/me; usa el escenario APRO-AUTH.
MERCADO_PAGO_TEST_APPROVAL=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=

# Correo de comprobantes
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# En producción, usa rutas en un volumen persistente.
IDENTITY_SECURITY_DB=
IDENTITY_SECURITY_KEY=
PAYMENTS_DB=
APP_BASE_URL=

# HTTPS solo para desarrollo local; configura con scripts/configurar_https_local.ps1.
LOCAL_HTTPS_CERT=
LOCAL_HTTPS_KEY=
LOCAL_HTTPS_PORT=5443
