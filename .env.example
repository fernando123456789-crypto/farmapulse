# Genera una SECRET_KEY privada y estable para este servidor.
SECRET_KEY=
SUPABASE_URL=
SUPABASE_KEY=
# Clave SECRETA de Supabase (rol service_role / sb_secret_...). SOLO servidor:
# Render -> Environment o tu .env local. Nunca en el navegador ni en Git.
SUPABASE_SECRET_KEY=
# Dónde se guardan pagos, bloqueos de identidad y sesiones revocadas:
#   supabase -> tablas fp_* de sql/05_pagos_y_seguridad.sql (obligatorio en producción)
#   sqlite   -> archivos locales en instance/ (solo desarrollo y pruebas)
STORAGE_BACKEND=sqlite
# Registro, reenvío y recuperación comparten 5 solicitudes/hora; login: 5/15 minutos.
# Producción requiere HTTPS, clave privada estable de al menos 32 caracteres y Redis.
APP_ENV=development
RATELIMIT_STORAGE_URI=memory://
# Solo Render Free con UN worker de gunicorn y sin Redis: acepta el límite en memoria.
RATELIMIT_ALLOW_MEMORY=
RENIEC_TOKEN=

# Solo credenciales de un comercio de pruebas de Perú. Los comercios reales se bloquean.
# Mantén el Access Token privado. Los compradores no necesitan cuenta de Mercado Pago.
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
# Solo con un comercio de pruebas verificado por /users/me; usa el escenario APRO-AUTH.
MERCADO_PAGO_TEST_APPROVAL=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=

# Correo de comprobantes. EMAIL_PROVIDER=resend (API HTTPS, para Render) o smtp (local).
# Render Free bloquea los puertos SMTP 25, 465 y 587: allí usa resend.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
# Con onboarding@resend.dev solo se puede enviar al correo de tu cuenta de Resend;
# para otros destinatarios verifica un dominio propio en Resend.
RESEND_FROM=FarmaPulse <onboarding@resend.dev>
# SMTP (solo local, p. ej. Gmail con contraseña de aplicación):
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Solo con STORAGE_BACKEND=sqlite (desarrollo). En producción se usa Supabase.
IDENTITY_SECURITY_DB=
IDENTITY_SECURITY_KEY=
PAYMENTS_DB=
APP_BASE_URL=

# HTTPS solo para desarrollo local; configura con scripts/configurar_https_local.ps1.
LOCAL_HTTPS_CERT=
LOCAL_HTTPS_KEY=
LOCAL_HTTPS_PORT=5443

# Panel /admin: correo (o varios, separados por coma) con rol administrador.
# La contraseña NO va aquí: se crea en Supabase Auth. Deja este valor vacío en el repositorio.
ADMIN_EMAIL=
